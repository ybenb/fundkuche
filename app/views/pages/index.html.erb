<%# Fooby Homepage replica with real images %>

<div class="fooby-hero">
  <div class="fooby-hero__eyebrow">Deine Rezeptwelt</div>
  <h1 class="fooby-hero__title">Was möchtest du heute kochen?</h1>
  <p class="fooby-hero__sub">Tausende Rezepte – von einfach bis raffiniert.</p>

  <div class="fooby-hero__search">
    <input type="text" placeholder="Rezepte, Zutaten, Kategorien ...">
    <button class="fooby-hero__search-btn">
      <i class="bi bi-search me-1"></i>Suchen
    </button>
  </div>

  <%= link_to fundkueche_path, class: 'fooby-hero__fundkueche-cta' do %>
    <i class="bi bi-snow2"></i>
    Fundküche öffnen – Rezepte aus deinem Kühlschrank
  <% end %>
</div>

<div class="fooby-page">
  <%# Categories row %>
  <div class="fooby-categories">
    <% [
      { label: 'Frühstück',   icon: 'bi-sun' },
      { label: 'Mittagessen', icon: 'bi-brightness-high' },
      { label: 'Abendessen',  icon: 'bi-moon-stars' },
      { label: 'Desserts',    icon: 'bi-cake2' },
      { label: 'Vegetarisch', icon: 'bi-leaf' },
      { label: 'Vegan',       icon: 'bi-flower1' },
      { label: 'Schnell',     icon: 'bi-lightning' },
      { label: 'Backen',      icon: 'bi-egg' }
    ].each do |cat| %>
      <a href="#" class="fooby-categories__item">
        <i class="bi <%= cat[:icon] %>"></i>
        <%= cat[:label] %>
      </a>
    <% end %>
  </div>

  <%# Featured recipes from Fooby API with real images %>
  <h2 class="fooby-section-title">Aktuelle Rezepte</h2>

  <div class="fooby-recipe-grid">
    <% if @featured_recipes.present? %>
      <% @featured_recipes.each do |recipe| %>
        <a href="<%= recipe[:url] %>" target="_blank" rel="noopener" class="fooby-recipe-card">
          <img src="<%= recipe[:image_url] %>"
               class="fooby-recipe-card__image"
               alt="<%= recipe[:title] %>"
               loading="lazy"
               onerror="this.parentElement.querySelector('.fooby-recipe-card__image-placeholder').style.display='flex';this.style.display='none'">
          <div class="fooby-recipe-card__image-placeholder" style="display:none">
            <i class="bi bi-journal-richtext"></i>
          </div>
          <div class="fooby-recipe-card__body">
            <div class="fooby-recipe-card__title"><%= recipe[:title] %></div>
            <div class="fooby-recipe-card__meta">
              <% if recipe[:active_time].present? %>
                <span class="fooby-recipe-card__time">
                  <i class="bi bi-clock"></i> <%= recipe[:active_time] %> Min. aktiv
                </span>
              <% end %>
              <% if recipe[:diet].present? %>
                <span class="fooby-recipe-card__diet"><%= recipe[:diet] %></span>
              <% end %>
            </div>
          </div>
        </a>
      <% end %>
    <% else %>
      <%# Skeleton loader while API loads %>
      <% 8.times do %>
        <div class="fooby-recipe-card fooby-recipe-card--skeleton">
          <div class="fooby-recipe-card__image-placeholder">
            <i class="bi bi-image" style="color:#ddd;font-size:2rem"></i>
          </div>
          <div class="fooby-recipe-card__body">
            <div class="fooby-skeleton-line" style="width:85%"></div>
            <div class="fooby-skeleton-line" style="width:50%;margin-top:8px;height:10px"></div>
          </div>
        </div>
      <% end %>
    <% end %>
  </div>

  <%# Fundküche promo banner %>
  <div class="fooby-fundkueche-banner mt-5">
    <div class="fooby-fundkueche-banner__icon">
      <i class="bi bi-snow2"></i>
    </div>
    <div class="fooby-fundkueche-banner__body">
      <div class="fooby-fundkueche-banner__title">Fundküche – Dein KI-Küchenchef</div>
      <div class="fooby-fundkueche-banner__sub">
        Mach ein Foto deines Kühlschranks und erhalte sofort passende Fooby-Rezepte –
        mit dem was du zuhause hast oder mit Coop-Einkaufsliste.
      </div>
    </div>
    <%= link_to fundkueche_path, class: 'btn-fooby flex-shrink-0' do %>
      <i class="bi bi-arrow-right"></i> Jetzt ausprobieren
    <% end %>
  </div>
</div>
