<%# Fooby Homepage %>

<%# ── Search hero ── %>
<div class="fooby-search-hero" data-controller="recipe-search">

  <div class="fooby-search-hero__card">
    <div class="fooby-search-hero__badge">Suchen &amp; Finden</div>
    <div class="fooby-search-hero__title">Was möchtest du kochen?</div>

    <%= form_with url: root_path, method: :get,
          data: {
            recipe_search_target: 'form',
            turbo_frame: 'recipes',
            turbo_action: 'advance'
          } do |f| %>
      <%= hidden_field_tag :category, @category %>
      <div class="fooby-search-hero__form-wrap">
        <div class="fooby-search-hero__form">
          <i class="bi bi-search fooby-search-hero__form-icon"></i>
          <%= f.text_field :q, value: @query,
                placeholder: 'Rezepte, Zutaten, Trends ...',
                autocomplete: 'off',
                data: {
                  recipe_search_target: 'input',
                  action: 'input->recipe-search#search'
                } %>
        </div>
      </div>
    <% end %>

    <%= link_to fundkueche_path, class: 'fooby-search-hero__fundkueche-cta' do %>
      <i class="bi bi-snow2"></i>
      Fundküche – Rezepte aus deinem Kühlschrank
    <% end %>
  </div>
</div>

<%# ── Main content ── %>
<div class="fooby-page">

  <%# Filter bar: plain links targeting the recipes turbo frame %>
  <div class="fooby-filter-bar">
    <% [['Alle', ''], ['Frühstück', 'Frühstück'], ['Hauptgericht', 'Hauptgericht'],
        ['Desserts', 'Desserts'], ['Vegetarisch', 'Vegetarisch'], ['Vegan', 'Vegan'],
        ['Ohne Laktose', 'Ohne Laktose'], ['Schnell', 'Schnell'],
        ['Backen', 'Backen'], ['Salate', 'Salate'], ['Suppen', 'Suppen']].each do |label, cat| %>
      <%= link_to label, root_path(category: cat, q: ''),
            class: "fooby-filter-bar__item #{@category == cat ? 'fooby-filter-bar__item--active' : ''}",
            data: { turbo_frame: 'recipes', turbo_action: 'advance' } %>
    <% end %>
  </div>

  <%# Section heading %>
  <h2 class="fooby-section-heading">
    <% if @category.present? %>
      <%= @category %>
    <% elsif @query.present? %>
      Ergebnisse für „<%= @query %>"
    <% else %>
      Aktuelle Rezepte
    <% end %>
  </h2>

  <%= turbo_frame_tag :recipes do %>
    <%= render 'pages/recipes_frame' %>
  <% end %>

  <%# Fundküche promo strip %>
  <div class="fooby-promo-strip">
    <div class="fooby-promo-strip__icon">
      <i class="bi bi-snow2"></i>
    </div>
    <div class="fooby-promo-strip__body">
      <div class="fooby-promo-strip__title">Fundküche – Dein KI-Küchenchef</div>
      <div class="fooby-promo-strip__sub">
        Foto vom Kühlschrank machen → KI erkennt Zutaten → passende Fooby-Rezepte sofort.
      </div>
    </div>
    <%= link_to fundkueche_path, class: 'fooby-promo-strip__btn' do %>
      <i class="bi bi-arrow-right"></i> Jetzt ausprobieren
    <% end %>
  </div>

</div>
