<%# Fooby Homepage 1:1 replica %>

<%# ── Search hero ── %>
<div class="fooby-search-hero">
  <div class="fooby-search-hero__title">Was möchtest du kochen?</div>
  <p class="fooby-search-hero__sub">Über 7000 Rezepte – entdecke dein nächstes Lieblingsgericht.</p>

  <div class="fooby-search-hero__form">
    <input type="text" placeholder="Rezepte, Zutaten, Kategorien ...">
    <button type="button">
      <i class="bi bi-search"></i>
      Suchen
    </button>
  </div>

  <%= link_to fundkueche_path, class: 'fooby-search-hero__fundkueche-cta' do %>
    <i class="bi bi-snow2"></i>
    Fundküche – Rezepte aus deinem Kühlschrank
  <% end %>
</div>

<%# ── Main content ── %>
<div class="fooby-page">

  <%# Filter bar %>
  <div class="fooby-filter-bar">
    <% [
      'Alle', 'Frühstück', 'Hauptgericht', 'Desserts',
      'Vegetarisch', 'Vegan', 'Ohne Laktose', 'Schnell', 'Backen', 'Salate', 'Suppen'
    ].each_with_index do |cat, i| %>
      <a href="#" class="fooby-filter-bar__item <%= 'fooby-filter-bar__item--active' if i == 0 %>">
        <%= cat %>
      </a>
    <% end %>
  </div>

  <%# Recipe grid with real Fooby images %>
  <h2 class="fooby-section-heading">Aktuelle Rezepte</h2>

  <div class="fooby-teaser-grid">
    <% if @featured_recipes.present? %>
      <% @featured_recipes.each do |recipe| %>
        <a href="<%= recipe[:url] %>" target="_blank" rel="noopener" class="teaser">
          <div class="teaser__img-container">
            <img class="teaser__img"
                 src="<%= recipe[:image_url] %>"
                 alt="<%= recipe[:title] %>"
                 loading="lazy"
                 onerror="this.style.display='none';this.parentElement.querySelector('.teaser__img-placeholder').style.display='flex'">
            <div class="teaser__img-placeholder" style="display:none">
              <i class="bi bi-image"></i>
            </div>
          </div>
          <div class="teaser__inner">
            <div class="teaser__header">
              <span class="teaser__type">Rezept</span>
            </div>
            <div class="teaser__body">
              <div class="teaser__body-title"><%= recipe[:title] %></div>
            </div>
          </div>
          <div class="teaser__meta-block">
            <div class="teaser__meta-inner">
              <% if recipe[:active_time].present? %>
                <span class="teaser__meta-item">
                  <i class="bi bi-clock"></i> <%= recipe[:active_time] %> Min.
                </span>
              <% end %>
              <% if recipe[:diet].present? %>
                <% recipe[:diet].split(',').first(1).each do |d| %>
                  <span class="teaser__diet-tag"><%= d.strip %></span>
                <% end %>
              <% end %>
            </div>
          </div>
        </a>
      <% end %>
    <% else %>
      <%# Skeleton cards while loading %>
      <% 8.times do %>
        <div class="teaser teaser--skeleton">
          <div class="teaser__img-container"></div>
          <div class="teaser__inner">
            <div class="skeleton-line" style="width:30%;height:10px;margin-bottom:8px"></div>
            <div class="skeleton-line" style="width:85%;height:18px;margin-bottom:6px"></div>
            <div class="skeleton-line" style="width:60%;height:14px"></div>
          </div>
          <div class="teaser__meta-block">
            <div class="skeleton-line" style="width:50%;height:10px"></div>
          </div>
        </div>
      <% end %>
    <% end %>
  </div>

  <%# Fundküche promo strip %>
  <div class="fooby-promo-strip">
    <div class="fooby-promo-strip__icon">
      <i class="bi bi-snow2"></i>
    </div>
    <div class="fooby-promo-strip__body">
      <div class="fooby-promo-strip__title">Fundküche – Dein KI-Küchenchef</div>
      <div class="fooby-promo-strip__sub">
        Foto vom Kühlschrank machen → KI erkennt Zutaten → passende Fooby-Rezepte sofort.
      </div>
    </div>
    <%= link_to fundkueche_path, class: 'fooby-promo-strip__btn' do %>
      <i class="bi bi-arrow-right"></i> Jetzt ausprobieren
    <% end %>
  </div>

</div>
