<!DOCTYPE html>
<html lang="de">
  <head>
    <title>Fundküche – Dein Kühlschrank. Dein Rezept.</title>
    <meta name="viewport" content="width=device-width,initial-scale=1">
    <%= csrf_meta_tags %>
    <%= csp_meta_tag %>
    <link rel="preconnect" href="https://fonts.googleapis.com">
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
    <link href="https://fonts.googleapis.com/css2?family=Source+Sans+3:wght@400;600;700;900&display=swap" rel="stylesheet">
    <%= stylesheet_link_tag 'application', 'data-turbo-track': 'reload' %>
    <%= javascript_include_tag 'application', 'data-turbo-track': 'reload', defer: true %>
    <%= hotwire_livereload_tags if Rails.env.development? %>
  </head>
  <body>
    <nav class="fooby-nav">
      <div class="fooby-nav__inner">
        <div class="fooby-nav__logo">
          <%= link_to root_path, class: 'fooby-logo-text' do %>fooby<% end %>
        </div>

        <ul class="fooby-nav__menu">
          <li><a href="#">Rezepte</a></li>
          <li><a href="#">Kochschule</a></li>
          <li><a href="#">FOOBYVERSUM</a></li>
          <li><a href="#">Leseecke</a></li>
        </ul>

        <div class="fooby-nav__search">
          <div class="fooby-nav__search-form d-none d-lg-block">
            <input type="text" placeholder="Was möchtest du kochen?">
            <i class="bi bi-search search-icon"></i>
          </div>

          <%= link_to fundkueche_path, class: 'fooby-nav__fundkueche-btn' do %>
            <i class="bi bi-snow2"></i>
            <span class="d-none d-md-inline">Fundküche öffnen</span>
            <span class="d-md-none">Fundküche</span>
          <% end %>

          <% if user_signed_in? %>
            <div class="fooby-nav__user">
              <div class="fooby-nav__myfooby-btn fooby-nav__myfooby-btn--active">
                <i class="bi bi-person-fill"></i>
                <span class="d-none d-md-inline">ZHAW</span>
              </div>
              <%= link_to destroy_user_session_path,
                    data: { turbo_method: :delete },
                    class: 'fooby-nav__signout',
                    title: 'Abmelden' do %>
                <i class="bi bi-box-arrow-right"></i>
              <% end %>
            </div>
          <% else %>
            <%= link_to new_user_session_path, class: 'fooby-nav__myfooby-btn' do %>
              <i class="bi bi-person"></i>
              <span class="d-none d-md-inline">Anmelden</span>
            <% end %>
          <% end %>
        </div>
      </div>
    </nav>

    <% flash.each do |type, message| %>
      <div class="fooby-flash">
        <div class="<%= flash_class(type) %> alert-dismissible fade show mb-0" role="alert">
          <%= message %>
          <button type="button" class="btn-close" data-bs-dismiss="alert"></button>
        </div>
      </div>
    <% end %>

    <%= yield %>
  </body>
</html>
