<div id="<%= dom_id fridge %>">
  <hr>
  <h3>Ingredients 🥦</h3>
  <table class="table">
    <tr class="row">
      <th class="col">Name</th>
      <th class="col">Quantity</th>
    </tr>
    <% fridge.ingredients.each do |ingredient| %>
      <tr class="row">
        <td class="col"><%= ingredient.name %></td>
        <td class="col"><%= ingredient.quantity %></td>
      </tr>
    <% end %>
  </table>

  <hr>
  <h3 class="mb-3 fw-bold">Recipe 👨‍🍳</h3>
  <div class="recipe-text">
    <%= simple_format(fridge.recipe) %>
  </div>
</div>
