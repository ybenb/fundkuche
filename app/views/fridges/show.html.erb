<%= turbo_stream_from(@fridge, :stream) %>

<%= button_to generate_recipe_fridge_path(@fridge.id), class: 'btn btn-primary' do %>
  <i class='bi bi-arrow-clockwise me-1'></i>
  <span>Generate Recipe</span>
<% end %>

<%= render @fridge %>

<div>
  <%= link_to 'Edit this fridge', edit_fridge_path(@fridge), class: 'btn btn-secondary' %>
  <%= link_to 'Back to fridges', fridges_path, class: 'btn btn-secondary' %>
  <button type="button" class="btn btn-secondary" onClick="window.print();">
    <i class="bi bi-printer"></i>
  </button>
  <%= button_to 'Destroy this fridge', @fridge, method: :delete, class: 'btn btn-danger mt-3' %>
</div>
