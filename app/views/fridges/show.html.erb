<%= turbo_stream_from(@fridge, :stream) %>

<div class="fk-result-page">

  <%# Breadcrumb %>
  <div class="fooby-breadcrumb">
    <%= link_to 'fooby', root_path %><span>/</span>
    <%= link_to 'Fundküche', fundkueche_path %><span>/</span>
    Mein Kühlschrank
  </div>

  <%# Ingredient chips header %>
  <div class="fk-fridge-summary">
    <div class="fk-fridge-summary__left">
      <h1 class="fk-fridge-summary__title">
        <i class="bi bi-snow2"></i> Mein Kühlschrank
      </h1>
      <div class="fk-fridge-summary__chips">
        <% @fridge.ingredients.each do |ing| %>
          <span class="fridge-chip">
            <i class="bi bi-check-circle-fill"></i>
            <%= ing.name %><% if ing.quantity.present? %> <small>(<%= ing.quantity %>)</small><% end %>
          </span>
        <% end %>
        <% if @fridge.ingredients.empty? %>
          <span class="fridge-chip fridge-chip--empty">Noch keine Zutaten</span>
        <% end %>
      </div>
    </div>
    <div class="fk-fridge-summary__actions">
      <%= link_to edit_fridge_path(@fridge), class: 'btn-fooby-outline btn-sm' do %>
        <i class="bi bi-pencil"></i> Bearbeiten
      <% end %>
      <%= button_to @fridge, method: :delete, class: 'btn btn-outline-danger btn-sm',
          form: { style: 'display:inline' },
          data: { turbo_confirm: 'Kühlschrank löschen?' } do %>
        <i class="bi bi-trash"></i>
      <% end %>
    </div>
  </div>

  <%# Recipe options — updated live via Turbo Stream when job completes %>
  <div id="fridge_recipes">
    <%= render 'recipe_results', fridge: @fridge, fooby_recipes: @fooby_recipes %>
  </div>

  <%# GPT recipe area %>
  <%= render @fridge %>

</div>
