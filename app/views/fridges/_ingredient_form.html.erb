<div class="nested-form-wrapper d-flex gap-2 align-items-start mb-2 ingredient-row">
  <div class="flex-grow-1">
    <%= f.input :name, label: false, placeholder: 'Name',
                       wrapper_html: { class: 'mb-0' },
                       input_html: { data: { ingredients_target: 'nameInput' } } %>
  </div>
  <div class="quantity-input">
    <%= f.input :quantity, label: false, placeholder: 'Qty',
                           wrapper_html: { class: 'mb-0' },
                           input_html: { data: { ingredients_target: 'quantityInput' } } %>
  </div>
  <button type="button" class="btn btn-outline-danger px-2" data-action="ingredients#remove">
    <i class="bi bi-trash-fill"></i>
  </button>
  <%= f.hidden_field :_destroy %>
</div>
