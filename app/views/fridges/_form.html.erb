<p class="text-black-50 bg-info-subtle p-3 rounded">
  <i class="bi bi-info-circle-fill"></i>
  scan a product's barcode or type it in to get tailor-made recipe suggestions instantly.
  You can also scan all the ingredients in your fridge to get recipe suggestions based on what you already have.
</p>
<div data-controller="image-detection" data-image-detection-ingredients-outlet="[data-controller=ingredients]" class="mb-4">
  <input type="file" data-image-detection-target="input" data-action="change->image-detection#upload">
</div>

<%= simple_form_for(@fridge,
                    data: { controller: 'ingredients', ingredients_wrapper_selector_value: '.nested-form-wrapper' }) do |f| %>
  <%= f.error_notification %>
  <%= f.error_notification message: f.object.errors[:base].to_sentence if f.object.errors[:base].present? %>
  <div data-controller="barcode-scanner" data-barcode-scanner-ingredients-outlet="[data-controller=ingredients]">
    <div id="barcode-scanner" class="rounded" width="600px" data-barcode-scanner-target="scanner"></div>
    <audio src="<%= asset_path('beep.wav') %>" preload data-barcode-scanner-target="audio"></audio>
    <button type="button" class="btn btn-secondary" data-action="barcode-scanner#startScanner">Start Barcode Scanner
    </button>
  </div>
  <hr>
  <h3>Ingredients🥦</h3>
  <table>
    <%= f.simple_fields_for :ingredients do |ingredient_fields| %>
      <%= render 'ingredient_form', f: ingredient_fields %>
    <% end %>

    <tbody data-ingredients-target="target" class="ingredient__wrapper">
    <template data-ingredients-target="template">
      <%= f.simple_fields_for :ingredients, Ingredient.new, child_index: 'NEW_RECORD' do |ingredient_fields| %>
        <%= render 'ingredient_form', f: ingredient_fields %>
      <% end %>
    </template>
    <button type="button" class="btn btn-danger mb-3" data-action="ingredients#add">Add Ingredient</button>
    </tbody>
  </table>

  <div class="form-actions">
    <%= f.submit 'Save Fridge', class: 'btn btn-primary' %>
  </div>
<% end %>
